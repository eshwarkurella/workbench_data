DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
# Comma-separated list of databases (table_counts.py and export_to_s3.py)
DB_NAMES=db_one,db_two

# ---------- export_to_s3.py ----------
# Root path in S3; files go to <S3_ROOT>/workbench/year=…/month=…/day=…/<db>/ and <S3_ROOT>/workbench/latest/<db>/
S3_ROOT=s3://your-bucket/some/prefix
# File formats written per table
EXPORT_FORMATS=parquet,csv
# AWS credentials come from the usual places (EC2 instance role, ~/.aws, or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
AWS_REGION=ap-south-1
